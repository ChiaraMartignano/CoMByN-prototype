    <text>
        <body>
            <div n="1" rend="align-right">
            <p n="title">
                <app>
                    <lem wit="#V #R #B #S">الباب</lem>
                    <rdg wit="#T">... الأبّ والابن والروح القدس الاه واحد الباب</rdg>
                    <rdg wit="#Q">بسم الأب والابن والروخ القدس الباب</rdg>
                </app>
                الأوّل <app>
                    <lem wit="#V #S #T"><app>
                            <lem wit="#V #S">من</lem>
                            <rdg wit="#T">في</rdg>
                        </app> كتاب الروضة </lem>
                    <rdg wit="#B #R #Q" type="om"></rdg>
                </app><app>
                    <lem wit="#Q #V #R #S">في</lem>
                    <rdg wit="#T" type="om"/>
                </app> الفضيلة <app>
                    <lem wit="#V #Q #B #R #S">وما قِيلَ فيها</lem>
                    <rdg wit="#T">وما فها</rdg>
                </app></p>
            <p n="def"> الفضيلة هي سيرة الاهية <app>
                    <lem>وهي</lem>
                    <rdg wit="#S" type="om_margin">وهي</rdg>
                </app> عرض لأنّ <app>
                    <lem wit="#V #R #S">المقابل</lem>
                    <rdg wit="#T">المقابلت</rdg>
                    <rdg wit="#Q #B">المقاتل</rdg>
                </app> لها <app>
                    <lem wit="#V #Q #R #B #S">الرذيلة</lem>
                    <rdg wit="#T">الردّ</rdg>
                </app> وهما جنسان تحت الكيفية.</p>
            <p> قال الأنجيل المقدّس: <app>
                    <lem wit="#V #B #R #S">إنّ</lem>
                    <rdg wit="#T" type="om"/>
                </app> السبيل <app>
                    <lem wit="#V #R #B #Q #S">التي</lem>
                    <rdg wit="#T">الذي</rdg>
                </app>
                    <app>
                    <lem wit="#V #B #Q #R #S">تؤدّي</lem>
                    <rdg wit="#T">يؤدّي</rdg>
                </app> إلى <app>
                    <lem wit="#V #B #Q #T #S">الحياة</lem>
                    <rdg wit="#R">الحيوة</rdg>
                </app> حرجة وضيقه. قال الرسول: لا
                تنقهر من الشرّ لكنّ استول عليه <app>
                    <lem wit="#S #T #V">بالخير</lem>
                    <rdg wit="#B #R #Q">من الخير</rdg>
                </app>. قال <app>
                    <lem wit="#V #R #S">سليمن</lem>
                    <rdg wit="#T">سلمن</rdg>
                    <rdg wit="#Q #B">سليمان</rdg>
                </app> الحكيم: كما أنّ الحصرم يضرّ <app>
                    <lem wit="#T #V">الأسنان</lem>
                    <rdg wit="#B #Q #R #S">بالأسنان</rdg>
                </app> والدخان <app>
                    <lem wit="#V #B #Q #S">للعيون</lem>
                    <rdg wit="#R">بالعيون</rdg>
                    <rdg wit="#T">العيون</rdg>
                </app>، هكذا النفاق يؤذي مستعمله. قال <app>
                    <lem wit="#V #Q #R #T #S">سيراخ</lem>
                    <rdg wit="#B">شيراخ</rdg>
                </app> : لا <app>
                    <lem wit="#V #B #Q #R #T">تعملن</lem>
                    <rdg wit="#S">تعمل</rdg>
                </app>  <app>
                    <lem wit="#V #R #B #S">شرّا</lem>
                    <rdg wit="#Q #T">شرّ</rdg>
                </app> فما يلمّ <app>
                    <lem wit="#T #Q #B #R #S">بك</lem>
                    <rdg wit="#V">وبك</rdg>
                </app>  <app>
                    <lem wit="#T #V">ولا الشرّ</lem>
                    <rdg wit="#B #R #Q">الشرّ</rdg>
                    <rdg wit="#S">والشرّ</rdg>
                </app>. قال القديس باسيليوس: تعلّم
                الفضيلة قنية كريمة <app>
                    <lem wit="#T #Q #B #R #V">لمقتنيها</lem>
                    <rdg wit="#S">لمفتنيها</rdg>
                </app> ومنظر عذب <app>
                    <lem wit="#V #B #Q #R #S">للخاضرين</lem>
                    <rdg wit="#T">للحاظرين</rdg>
                </app> . قال <app>
                    <lem wit="#T #Q #R #S">الثولوغس</lem>
                    <rdg wit="#B">الثالوغس</rdg>
                    <rdg wit="#V">الثاولوغس</rdg>
                </app>: ليس الفعل الميمون يوجب <app>
                    <lem wit="#T #B #Q #R #V">الصيت</lem>
                    <rdg wit="#S">الصبت</rdg>
                </app> ، للأنام فقط <app>
                    <lem wit="#V #B #Q #S">لكنّ الشرّ </lem>
                    <rdg wit="#R">لكنّ والشرّ</rdg>
                    <rdg wit="#T">للشرّ </rdg>
                </app> القامع <app>
                    <lem wit="#S #V #R #Q #B">سورة الخبثاء</lem>
                    <rdg wit="#T">صورة الحيا</rdg>
                </app> . <app>
                    <lem wit="#T #S">قال</lem>
                    <rdg wit="#B #R">قال القديس</rdg>
                    <rdg wit="#Q">قال قال القديس</rdg>
                    <rdg wit="#V">والقدس</rdg>
                    <rdg wit="#S" hand="#S1" type="add_margin">القديس يحنا</rdg>
                </app>
                يحنا الذهبي الفم: ليس أعداء <app>
                    <lem wit="#B #R #V">المهتمين</lem>
                    <rdg wit="#S"><subst>
                            <del>المهمتمين</del>
                            <add>المهتمين</add>
                        </subst></rdg>
                    <rdg wit="#T">المقيدين</rdg>
                </app> بالفضيلة قليلين. قال <app><!--
                        quù
                        -->
                    <lem wit="#V #B #Q #S">اغريغوريوس </lem>
                    <rdg wit="#R">غريغوريوس</rdg>
                    <rdg wit="#T">اغريغوريو</rdg>
                </app><app>
                    <lem wit="#V #T #Q #B">أسقف</lem>
                    <rdg wit="#S"><subst>
                            <del>أسقق</del>
                            <add>أسقف</add>
                        </subst></rdg>
                    <rdg wit="#R" type="om"></rdg><!-- qui -->
                </app> نيسس: وقوف الرذيلة ابتدأ
                نهضة الفضيلة. <app>
                    <lem wit="#V #S"
                        type="lem" i="قال فيلن" f="الشرّ">قال فيلن: خروج الفضيلة يجترح ولوج الرذيلة
                كما، <app>
                            <lem wit="#R #V">بعكسه</lem>
                            <rdg wit="#B #Q #S">يعكسه</rdg>
                        </app>، إذا ابتعد
                الخير توطّد الشرّ </lem>
                    <rdg wit="#T" type="om"></rdg>
                </app>. قال <app>
                    <lem wit="#S #B #Q #R #V">قليمس</lem>
                    <rdg wit="#T">اقليمس</rdg>
                </app>: <app>
                    <lem wit="#S #B #Q #R #V">التخلّف</lem>
                    <rdg wit="#T">التحاىق</rdg>
                </app> عن الرذايل مبدئ <app>
                    <lem wit="#S #B #R #Q #V">الخلاص</lem>
                    <rdg wit="#T">الخير والأخلاض</rdg>
                </app>. <app>
                    <lem wit="#S #V" type="lem"
                        i="قال نيلس" f="الميناء"> قال نيلس: اجذل إذا فعلت الفضيلة <app>
                            <lem wit="#B #Q #R #V">لكنّ</lem>
                            <rdg wit="#S" type="om"/>
                        </app> لا تترفع لئلًا
                يعرض لك العطب في الميناء. </lem>
                    <rdg wit="#T" type="om"></rdg>
                </app> قال <app>
                    <lem wit="#V #Q #R #B #S">كيرللس</lem>
                    <rdg wit="#T">كبر الس</rdg>
                </app> . النفس تتدنس<app>
                    <lem wit="#V #R #Q #B #S">بأربعة</lem>
                    <rdg wit="#T">بأربع</rdg>
                </app> أشياء, بالمشي في المدينة وترك
                غضّ الطرف، <app>
                    <lem wit="#V #R #B #S">وبالتعرّف</lem>
                    <rdg wit="#T">وبالنعُزف</rdg>
                </app> بالنساء، وبمصادقة رؤساء
                العالم، وبمودة المفاوضة بالجسدية والكلام الباطل. <app>
                    <lem wit="#V #B #S" type="lem"
                        i="قال بلوطرخس" f="الله"> قال <app>
                            <lem wit="#V #S #B">بلوطرخس</lem>
                            <rdg wit="#R #Q">بوليطرخس</rdg>
                        </app>: أمّا
                الغذاء فيظهر عذبًا <app>
                            <lem wit="#V #R #B #Q">المرتاضين</lem>
                            <rdg wit="#S">للمرتاضين</rdg>
                        </app> وأمّا
                الفضيلة فللمتأدبين. قال افلاطون. إنّ الرجل الجبان الضعيف المستغرم بالثروة والتنعّم
                لا يفي قدره <app>
                            <lem wit="#V #S #R #B">بالكلب</lem>
                            <rdg wit="#Q">بالكلية</rdg>
                        </app> ولا العير. قال <app>
                            <lem wit="#V">فليطرخس</lem>
                            <rdg wit="#B #R #Q">بوليطرخس</rdg>
                            <rdg wit="#S"><subst>
                                    <del>قليطرخوس</del>
                                    <add>قليطرخس</add>
                                </subst></rdg>
                        </app>:
                إن تكن لك فضيلة <app>
                            <lem wit="#V #S">فكلّ</lem>
                            <rdg wit="#B #R #Q">فكلًا</rdg>
                        </app> لك <app>
                            <lem wit="#V">وإن تكن لك</lem>
                            <rdg wit="#Q #R #B">وإن لم تكن لك</rdg>
                            <rdg wit="#S" type="om"/>
                            <rdg wit="#S" hand="#S1" type="add_margin">وإن تكن لك</rdg>
                        </app>
                    <app>
                            <lem wit="#V #S">رذيلة</lem>
                            <rdg wit="#R #Q #B">فضيلة</rdg><!-- verifica Q B-->
                        </app> فولا ذاتك
                لك. قال ديمقريطس: فعلك ما ليس بأهل الله <app>
                            <lem wit="#V #Q #R #B">يجعلك</lem>
                            <rdg wit="#S"><subst>
                                    <del>تجعلك</del>
                                    <add>يجعلك</add>
                                </subst></rdg>
                        </app>
                غير مستحق له. قال لافن. وقد سُئِلَ <app>
                            <lem wit="#V #Q #B">ولماذا</lem>
                            <rdg wit="#R">لماذا</rdg>
                            <rdg wit="#S"><subst>
                                    <del>وكلما</del>
                                    <add>ولماذا</add>
                                </subst></rdg>
                        </app> <app>
                            <lem type="syn"><app>
                                    <lem type="#conieci">اسبرتي</lem>
                                    <rdg wit="#Q #R #B">اسمرني</rdg>
                                    <rdg wit="#V">اسبرتي اسم مدينة</rdg>
                                    <rdg wit="#S">اسبرني</rdg>
                                </app></lem>
                            <rdg wit="#S" type="add_margin">اسم مدينة</rdg>
                        </app>
                بلا سور لا <app>
                            <lem type="syn"><app>
                                    <lem wit="#V #Q #B">يمين</lem>
                                    <rdg wit="#S">تمين</rdg>
                                    <rdg wit="#R">الأيمن</rdg>
                                </app></lem>
                            <rdg wit="#S" type="add_margin">أي تكذب</rdg>
                            <rdg wit="#V" type="add_margin">لا يمين أي يكذب</rdg>
                        </app>
                لأنّها قد سُوِّرَت بمناقب القاطنين <app>
                            <lem wit="#V #S">القاطنين</lem>
                            <rdg wit="#B #R #Q">القاطنين بها</rdg>
                        </app> .
                قال ايسيطاقوس: إنّ الاخيار من الناس لهم <app>
                            <lem wit="#B #Q #R #V">جزء ما</lem>
                            <rdg wit="#S">حذما</rdg>
                        </app> من الله </lem>
                    <rdg wit="#T" type="om"></rdg>
                </app><!-- الباب الثالث في
                    العفة.
                    <app>
                    <rdg wit="#T #V"/>
                    <rdg wit="#S">العفة</rdg>
                </app> قلّة <app>
                    <rdg wit="#V #S">الانقياد</rdg>
                    <rdg wit="#T">الانفياد إلى الشهورات والجوف</rdg>
                </app>  <app>
                    <rdg wit="#V">للشهوات</rdg>
                    <rdg wit="#S">للشهورات</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">والخوف</rdg>
                    <rdg wit="#T"/>
                </app> من التانيب <app>
                    <rdg wit="#V">واستقامة</rdg>
                    <rdg wit="#T #S">واستقامه</rdg>
                </app> الطريقة في <app>
                    <rdg wit="#V">إننان</rdg>
                    <rdg wit="#S">إثناء</rdg>
                    <rdg wit="#T">أبنات</rdg>
                </app> الأمور <app>
                    <rdg wit="#V #S">الكبيرة والصغيرة</rdg>
                    <rdg wit="#T">الكبير والصغير</rdg>
                </app> . قال الانجيل <app>
                    <rdg wit="#V"/>
                    <rdg wit="#T #S">المقدس</rdg>
                </app> . من نظر إلى امرأة <app>
                    <rdg wit="#V #S">ليشتهيها</rdg>
                    <rdg wit="#T">واشتهافي نفسه</rdg>
                </app> فقد <app>
                    <rdg wit="#V">رتابها</rdg>
                    <rdg wit="#S">رنابها</rdg>
                    <rdg wit="#T">زنابها</rdg>
                </app> في قلبه. قال الرسول <app>
                    <rdg wit="#V #S">.</rdg>
                    <rdg wit="#T">يولص</rdg>
                </app> أمّا علمتم أنّ <app>
                    <rdg wit="#V">أعضائكم</rdg>
                    <rdg wit="#S">أجسامكم</rdg>
                    <rdg wit="#T">أغضاكم أغضاء</rdg>
                </app>  <app>
                    <rdg wit="#V #S">أعضاء</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">المسيح</rdg>
                    <rdg wit="#T #S">المسايح</rdg>
                </app>  <app>
                    <rdg wit="#T #V">هي</rdg>
                    <rdg wit="#S"/>
                </app>  <app>
                    <rdg wit="#V #S">أفأصلح</rdg>
                    <rdg wit="#T">فأصلح</rdg>
                </app> أو صال <app>
                    <rdg wit="#V #S">المسيح</rdg>
                    <rdg wit="#T">المسايح</rdg>
                </app> أو صال <app>
                    <rdg wit="#V">الخلبن</rdg>
                    <rdg wit="#T #S">الخلين</rdg>
                </app> كلا أو ما عرفتم أنّ المتلصق
                بالفاجرة <app>
                    <rdg wit="#V #S">جسد</rdg>
                    <rdg wit="#T">جسدًا</rdg>
                </app> واحد هو <app>
                    <rdg wit="#V #S">والسادك</rdg>
                    <rdg wit="#T">والسادل</rdg>
                </app> بالله <app>
                    <rdg wit="#V #S">روح واحد</rdg>
                    <rdg wit="#T">روحًا واحدًا</rdg>
                </app> هو. قال ايوب. <app>
                    <rdg wit="#V">إن</rdg>
                    <rdg wit="#T #S">إنّ</rdg>
                </app>  <app>
                    <rdg wit="#V #S">قفا قلبي</rdg>
                    <rdg wit="#T">تفاقبني</rdg>
                </app> امرأة رجل أخر <app>
                    <rdg wit="#V">وواظبت</rdg>
                    <rdg wit="#T #S">واطنبت</rdg>
                </app> الجلوس على بابها <app>
                    <rdg wit="#V #S">فسيترضي</rdg>
                    <rdg wit="#T">فسترخا</rdg>
                </app> امرأتي <app>
                    <rdg wit="#V #S">رجلًا</rdg>
                    <rdg wit="#T">رجل</rdg>
                </app> غيري. قال القديس باسيليوس العفّة في
                الهرم ليست عفة لكنّ ضعفًا عن الفجور. <app>
                    <rdg wit="#V #S">قال الثاولوغس. انقياض الشيمة أفضل بانبساطها والأنا الداثر لا</rdg>
                    <rdg wit="#T">من</rdg>
                </app>  <app>
                    <rdg wit="#V">يوثق</rdg>
                    <rdg wit="#S">يوتق</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">به على الطبيب. من</rdg>
                    <rdg wit="#T"/>
                </app> كتاب <app>
                    <rdg wit="#V #S">اقليمقس.</rdg>
                    <rdg wit="#T">اقليمس</rdg>
                </app> الخادم <app>
                    <rdg wit="#T #V">بطنه</rdg>
                    <rdg wit="#S">بظنه</rdg>
                </app>  <app>
                    <rdg wit="#V #S">والموثران</rdg>
                    <rdg wit="#T">والموثر أنّ</rdg>
                </app> يقهر <app>
                    <rdg wit="#V #S">الروح</rdg>
                    <rdg wit="#T">روح الر… يظاهي للمطفى</rdg>
                </app>  <app>
                    <rdg wit="#V">الزنايضا</rdg>
                    <rdg wit="#S">الرتايضا</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">هي للمطفي</rdg>
                    <rdg wit="#T"/>
                </app> النار <app>
                    <rdg wit="#V #S">بالدهن. قال</rdg>
                    <rdg wit="#T">بالرهن</rdg>
                </app>  <app>
                    <rdg wit="#V">مسخيون</rdg>
                    <rdg wit="#S">مسحيون</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">ليس العفيف</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">الجانح</rdg>
                    <rdg wit="#S">الحانح</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">عن</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">المحطور</rdg>
                    <rdg wit="#S">المحظور</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">عليه لكنّ</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">الصنين</rdg>
                    <rdg wit="#S">الظنين</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">بالمسامح فيه</rdg>
                    <rdg wit="#T"/>
                </app> . قال سقراط العفة هي <app>
                    <rdg wit="#V #S">قمع</rdg>
                    <rdg wit="#T">قمح</rdg>
                </app> اللذة بالجسد <app>
                    <rdg wit="#V #S">. قال</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">ديوجانس</rdg>
                    <rdg wit="#S">ذيوجانس</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">. صعب هو أن تستولى المجاهدون</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">والمعيون</rdg>
                    <rdg wit="#S">والمعنون</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">على امساك البطن واللذات أمّا</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V">هولاء</rdg>
                    <rdg wit="#S">هو لا</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
                    <rdg wit="#V #S">فلإجل الضرب وأمّا</rdg>
                    <rdg wit="#T"/>
                </app>  <app>
