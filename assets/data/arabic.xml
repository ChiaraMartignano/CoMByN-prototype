    <text>
        <body>
            <div n="1" rend="rtl">
            <p n="title">
                <app>
                    <lem rend="rtl" wit="#V #R #B #S">الباب</lem>
                    <rdg rend="rtl" wit="#T">... الأبّ والابن والروح القدس الاه واحد الباب</rdg>
                    <rdg rend="rtl" wit="#Q">بسم الأب والابن والروخ القدس الباب</rdg>
                </app>
                الأوّل <app>
                    <lem rend="rtl" wit="#V #S #T"><app>
                            <lem rend="rtl" wit="#V #S">من</lem>
                            <rdg rend="rtl" wit="#T">في</rdg>
                        </app> كتاب الروضة </lem>
                    <rdg rend="rtl" wit="#B #R #Q" type="om"></rdg>
                </app><app>
                    <lem rend="rtl" wit="#Q #V #R #S">في</lem>
                    <rdg rend="rtl" wit="#T" type="om"/>
                </app> الفضيلة <app>
                    <lem rend="rtl" wit="#V #Q #B #R #S">وما قِيلَ فيها</lem>
                    <rdg rend="rtl" wit="#T">وما فها</rdg>
                </app></p>
            <p n="def"> الفضيلة هي سيرة الاهية <app>
                    <lem rend="rtl">وهي</lem>
                    <rdg rend="rtl" wit="#S" type="om_margin">وهي</rdg>
                </app> عرض لأنّ <app>
                    <lem rend="rtl" wit="#V #R #S">المقابل</lem>
                    <rdg rend="rtl" wit="#T">المقابلت</rdg>
                    <rdg rend="rtl" wit="#Q #B">المقاتل</rdg>
                </app> لها <app>
                    <lem rend="rtl" wit="#V #Q #R #B #S">الرذيلة</lem>
                    <rdg rend="rtl" wit="#T">الردّ</rdg>
                </app> وهما جنسان تحت الكيفية.</p>
            <p> قال الأنجيل المقدّس: <app>
                    <lem rend="rtl" wit="#V #B #R #S">إنّ</lem>
                    <rdg rend="rtl" wit="#T" type="om"/>
                </app> السبيل <app>
                    <lem rend="rtl" wit="#V #R #B #Q #S">التي</lem>
                    <rdg rend="rtl" wit="#T">الذي</rdg>
                </app>
                    <app>
                    <lem rend="rtl" wit="#V #B #Q #R #S">تؤدّي</lem>
                    <rdg rend="rtl" wit="#T">يؤدّي</rdg>
                </app> إلى <app>
                    <lem rend="rtl" wit="#V #B #Q #T #S">الحياة</lem>
                    <rdg rend="rtl" wit="#R">الحيوة</rdg>
                </app> حرجة وضيقه. قال الرسول: لا
                تنقهر من الشرّ لكنّ استول عليه <app>
                    <lem rend="rtl" wit="#S #T #V">بالخير</lem>
                    <rdg rend="rtl" wit="#B #R #Q">من الخير</rdg>
                </app>. قال <app>
                    <lem rend="rtl" wit="#V #R #S">سليمن</lem>
                    <rdg rend="rtl" wit="#T">سلمن</rdg>
                    <rdg rend="rtl" wit="#Q #B">سليمان</rdg>
                </app> الحكيم: كما أنّ الحصرم يضرّ <app>
                    <lem rend="rtl" wit="#T #V">الأسنان</lem>
                    <rdg rend="rtl" wit="#B #Q #R #S">بالأسنان</rdg>
                </app> والدخان <app>
                    <lem rend="rtl" wit="#V #B #Q #S">للعيون</lem>
                    <rdg rend="rtl" wit="#R">بالعيون</rdg>
                    <rdg rend="rtl" wit="#T">العيون</rdg>
                </app>، هكذا النفاق يؤذي مستعمله. قال <app>
                    <lem rend="rtl" wit="#V #Q #R #T #S">سيراخ</lem>
                    <rdg rend="rtl" wit="#B">شيراخ</rdg>
                </app> : لا <app>
                    <lem rend="rtl" wit="#V #B #Q #R #T">تعملن</lem>
                    <rdg rend="rtl" wit="#S">تعمل</rdg>
                </app>  <app>
                    <lem rend="rtl" wit="#V #R #B #S">شرّا</lem>
                    <rdg rend="rtl" wit="#Q #T">شرّ</rdg>
                </app> فما يلمّ <app>
                    <lem rend="rtl" wit="#T #Q #B #R #S">بك</lem>
                    <rdg rend="rtl" wit="#V">وبك</rdg>
                </app>  <app>
                    <lem rend="rtl" wit="#T #V">ولا الشرّ</lem>
                    <rdg rend="rtl" wit="#B #R #Q">الشرّ</rdg>
                    <rdg rend="rtl" wit="#S">والشرّ</rdg>
                </app>. قال القديس باسيليوس: تعلّم
                الفضيلة قنية كريمة <app>
                    <lem rend="rtl" wit="#T #Q #B #R #V">لمقتنيها</lem>
                    <rdg rend="rtl" wit="#S">لمفتنيها</rdg>
                </app> ومنظر عذب <app>
                    <lem rend="rtl" wit="#V #B #Q #R #S">للخاضرين</lem>
                    <rdg rend="rtl" wit="#T">للحاظرين</rdg>
                </app> . قال <app>
                    <lem rend="rtl" wit="#T #Q #R #S">الثولوغس</lem>
                    <rdg rend="rtl" wit="#B">الثالوغس</rdg>
                    <rdg rend="rtl" wit="#V">الثاولوغس</rdg>
                </app>: ليس الفعل الميمون يوجب <app>
                    <lem rend="rtl" wit="#T #B #Q #R #V">الصيت</lem>
                    <rdg rend="rtl" wit="#S">الصبت</rdg>
                </app> ، للأنام فقط <app>
                    <lem rend="rtl" wit="#V #B #Q #S">لكنّ الشرّ </lem>
                    <rdg rend="rtl" wit="#R">لكنّ والشرّ</rdg>
                    <rdg rend="rtl" wit="#T">للشرّ </rdg>
                </app> القامع <app>
                    <lem rend="rtl" wit="#S #V #R #Q #B">سورة الخبثاء</lem>
                    <rdg rend="rtl" wit="#T">صورة الحيا</rdg>
                </app> . <app>
                    <lem rend="rtl" wit="#T #S">قال</lem>
                    <rdg rend="rtl" wit="#B #R">قال القديس</rdg>
                    <rdg rend="rtl" wit="#Q">قال قال القديس</rdg>
                    <rdg rend="rtl" wit="#V">والقدس</rdg>
                    <rdg rend="rtl" wit="#S" hand="#S1" type="add_margin">القديس يحنا</rdg>
                </app>
                يحنا الذهبي الفم: ليس أعداء <app>
                    <lem rend="rtl" wit="#B #R #V">المهتمين</lem>
                    <rdg rend="rtl" wit="#S"><subst>
                            <del>المهمتمين</del>
                            <add>المهتمين</add>
                        </subst></rdg>
                    <rdg rend="rtl" wit="#T">المقيدين</rdg>
                </app> بالفضيلة قليلين. قال <app><!--
                        quù
                        -->
                    <lem rend="rtl" wit="#V #B #Q #S">اغريغوريوس </lem>
                    <rdg rend="rtl" wit="#R">غريغوريوس</rdg>
                    <rdg rend="rtl" wit="#T">اغريغوريو</rdg>
                </app><app>
                    <lem rend="rtl" wit="#V #T #Q #B">أسقف</lem>
                    <rdg rend="rtl" wit="#S"><subst>
                            <del>أسقق</del>
                            <add>أسقف</add>
                        </subst></rdg>
                    <rdg rend="rtl" wit="#R" type="om"></rdg><!-- qui -->
                </app> نيسس: وقوف الرذيلة ابتدأ
                نهضة الفضيلة. <app>
                    <lem rend="rtl" wit="#V #S"
                        type="lem" i="قال فيلن" f="الشرّ">قال فيلن: خروج الفضيلة يجترح ولوج الرذيلة
                كما، <app>
                            <lem rend="rtl" wit="#R #V">بعكسه</lem>
                            <rdg rend="rtl" wit="#B #Q #S">يعكسه</rdg>
                        </app>، إذا ابتعد
                الخير توطّد الشرّ </lem>
                    <rdg rend="rtl" wit="#T" type="om"></rdg>
                </app>. قال <app>
                    <lem rend="rtl" wit="#S #B #Q #R #V">قليمس</lem>
                    <rdg rend="rtl" wit="#T">اقليمس</rdg>
                </app>: <app>
                    <lem rend="rtl" wit="#S #B #Q #R #V">التخلّف</lem>
                    <rdg rend="rtl" wit="#T">التحاىق</rdg>
                </app> عن الرذايل مبدئ <app>
                    <lem rend="rtl" wit="#S #B #R #Q #V">الخلاص</lem>
                    <rdg rend="rtl" wit="#T">الخير والأخلاض</rdg>
                </app>. <app>
                    <lem rend="rtl" wit="#S #V" type="lem"
                        i="قال نيلس" f="الميناء"> قال نيلس: اجذل إذا فعلت الفضيلة <app>
                            <lem rend="rtl" wit="#B #Q #R #V">لكنّ</lem>
                            <rdg rend="rtl" wit="#S" type="om"/>
                        </app> لا تترفع لئلًا
                يعرض لك العطب في الميناء. </lem>
                    <rdg rend="rtl" wit="#T" type="om"></rdg>
                </app> قال <app>
                    <lem rend="rtl" wit="#V #Q #R #B #S">كيرللس</lem>
                    <rdg rend="rtl" wit="#T">كبر الس</rdg>
                </app> . النفس تتدنس<app>
                    <lem rend="rtl" wit="#V #R #Q #B #S">بأربعة</lem>
                    <rdg rend="rtl" wit="#T">بأربع</rdg>
                </app> أشياء, بالمشي في المدينة وترك
                غضّ الطرف، <app>
                    <lem rend="rtl" wit="#V #R #B #S">وبالتعرّف</lem>
                    <rdg rend="rtl" wit="#T">وبالنعُزف</rdg>
                </app> بالنساء، وبمصادقة رؤساء
                العالم، وبمودة المفاوضة بالجسدية والكلام الباطل. <app>
                    <lem rend="rtl" wit="#V #B #S" type="lem"
                        i="قال بلوطرخس" f="الله"> قال <app>
                            <lem rend="rtl" wit="#V #S #B">بلوطرخس</lem>
                            <rdg rend="rtl" wit="#R #Q">بوليطرخس</rdg>
                        </app>: أمّا
                الغذاء فيظهر عذبًا <app>
                            <lem rend="rtl" wit="#V #R #B #Q">المرتاضين</lem>
                            <rdg rend="rtl" wit="#S">للمرتاضين</rdg>
                        </app> وأمّا
                الفضيلة فللمتأدبين. قال افلاطون. إنّ الرجل الجبان الضعيف المستغرم بالثروة والتنعّم
                لا يفي قدره <app>
                            <lem rend="rtl" wit="#V #S #R #B">بالكلب</lem>
                            <rdg rend="rtl" wit="#Q">بالكلية</rdg>
                        </app> ولا العير. قال <app>
                            <lem rend="rtl" wit="#V">فليطرخس</lem>
                            <rdg rend="rtl" wit="#B #R #Q">بوليطرخس</rdg>
                            <rdg rend="rtl" wit="#S"><subst>
                                    <del>قليطرخوس</del>
                                    <add>قليطرخس</add>
                                </subst></rdg>
                        </app>:
                إن تكن لك فضيلة <app>
                            <lem rend="rtl" wit="#V #S">فكلّ</lem>
                            <rdg rend="rtl" wit="#B #R #Q">فكلًا</rdg>
                        </app> لك <app>
                            <lem rend="rtl" wit="#V">وإن تكن لك</lem>
                            <rdg rend="rtl" wit="#Q #R #B">وإن لم تكن لك</rdg>
                            <rdg rend="rtl" wit="#S" type="om"/>
                            <rdg rend="rtl" wit="#S" hand="#S1" type="add_margin">وإن تكن لك</rdg>
                        </app>
                    <app>
                            <lem rend="rtl" wit="#V #S">رذيلة</lem>
                            <rdg rend="rtl" wit="#R #Q #B">فضيلة</rdg><!-- verifica Q B-->
                        </app> فولا ذاتك
                لك. قال ديمقريطس: فعلك ما ليس بأهل الله <app>
                            <lem rend="rtl" wit="#V #Q #R #B">يجعلك</lem>
                            <rdg rend="rtl" wit="#S"><subst>
                                    <del>تجعلك</del>
                                    <add>يجعلك</add>
                                </subst></rdg>
                        </app>
                غير مستحق له. قال لافن. وقد سُئِلَ <app>
                            <lem rend="rtl" wit="#V #Q #B">ولماذا</lem>
                            <rdg rend="rtl" wit="#R">لماذا</rdg>
                            <rdg rend="rtl" wit="#S"><subst>
                                    <del>وكلما</del>
                                    <add>ولماذا</add>
                                </subst></rdg>
                        </app> <app>
                            <lem rend="rtl" type="syn"><app>
                                    <lem rend="rtl" type="#conieci">اسبرتي</lem>
                                    <rdg rend="rtl" wit="#Q #R #B">اسمرني</rdg>
                                    <rdg rend="rtl" wit="#V">اسبرتي اسم مدينة</rdg>
                                    <rdg rend="rtl" wit="#S">اسبرني</rdg>
                                </app></lem>
                            <rdg rend="rtl" wit="#S" type="add_margin">اسم مدينة</rdg>
                        </app>
                بلا سور لا <app>
                            <lem rend="rtl" type="syn"><app>
                                    <lem rend="rtl" wit="#V #Q #B">يمين</lem>
                                    <rdg rend="rtl" wit="#S">تمين</rdg>
                                    <rdg rend="rtl" wit="#R">الأيمن</rdg>
                                </app></lem>
                            <rdg rend="rtl" wit="#S" type="add_margin">أي تكذب</rdg>
                            <rdg rend="rtl" wit="#V" type="add_margin">لا يمين أي يكذب</rdg>
                        </app>
                لأنّها قد سُوِّرَت بمناقب القاطنين <app>
                            <lem rend="rtl" wit="#V #S">القاطنين</lem>
                            <rdg rend="rtl" wit="#B #R #Q">القاطنين بها</rdg>
                        </app> .
                قال ايسيطاقوس: إنّ الاخيار من الناس لهم <app>
                            <lem rend="rtl" wit="#B #Q #R #V">جزء ما</lem>
                            <rdg rend="rtl" wit="#S">حذما</rdg>
                        </app> من الله </lem>
                    <rdg rend="rtl" wit="#T" type="om"></rdg>
                </app><!-- الباب الثالث في
                    العفة.
                    <app>
                    <rdg rend="rtl" wit="#T #V"/>
                    <rdg rend="rtl" wit="#S">العفة</rdg>
                </app> قلّة <app>
                    <rdg rend="rtl" wit="#V #S">الانقياد</rdg>
                    <rdg rend="rtl" wit="#T">الانفياد إلى الشهورات والجوف</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V">للشهوات</rdg>
                    <rdg rend="rtl" wit="#S">للشهورات</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">والخوف</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app> من التانيب <app>
                    <rdg rend="rtl" wit="#V">واستقامة</rdg>
                    <rdg rend="rtl" wit="#T #S">واستقامه</rdg>
                </app> الطريقة في <app>
                    <rdg rend="rtl" wit="#V">إننان</rdg>
                    <rdg rend="rtl" wit="#S">إثناء</rdg>
                    <rdg rend="rtl" wit="#T">أبنات</rdg>
                </app> الأمور <app>
                    <rdg rend="rtl" wit="#V #S">الكبيرة والصغيرة</rdg>
                    <rdg rend="rtl" wit="#T">الكبير والصغير</rdg>
                </app> . قال الانجيل <app>
                    <rdg rend="rtl" wit="#V"/>
                    <rdg rend="rtl" wit="#T #S">المقدس</rdg>
                </app> . من نظر إلى امرأة <app>
                    <rdg rend="rtl" wit="#V #S">ليشتهيها</rdg>
                    <rdg rend="rtl" wit="#T">واشتهافي نفسه</rdg>
                </app> فقد <app>
                    <rdg rend="rtl" wit="#V">رتابها</rdg>
                    <rdg rend="rtl" wit="#S">رنابها</rdg>
                    <rdg rend="rtl" wit="#T">زنابها</rdg>
                </app> في قلبه. قال الرسول <app>
                    <rdg rend="rtl" wit="#V #S">.</rdg>
                    <rdg rend="rtl" wit="#T">يولص</rdg>
                </app> أمّا علمتم أنّ <app>
                    <rdg rend="rtl" wit="#V">أعضائكم</rdg>
                    <rdg rend="rtl" wit="#S">أجسامكم</rdg>
                    <rdg rend="rtl" wit="#T">أغضاكم أغضاء</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">أعضاء</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app>  <app>
                    <rdg rend="rtl" wit="#V">المسيح</rdg>
                    <rdg rend="rtl" wit="#T #S">المسايح</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#T #V">هي</rdg>
                    <rdg rend="rtl" wit="#S"/>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">أفأصلح</rdg>
                    <rdg rend="rtl" wit="#T">فأصلح</rdg>
                </app> أو صال <app>
                    <rdg rend="rtl" wit="#V #S">المسيح</rdg>
                    <rdg rend="rtl" wit="#T">المسايح</rdg>
                </app> أو صال <app>
                    <rdg rend="rtl" wit="#V">الخلبن</rdg>
                    <rdg rend="rtl" wit="#T #S">الخلين</rdg>
                </app> كلا أو ما عرفتم أنّ المتلصق
                بالفاجرة <app>
                    <rdg rend="rtl" wit="#V #S">جسد</rdg>
                    <rdg rend="rtl" wit="#T">جسدًا</rdg>
                </app> واحد هو <app>
                    <rdg rend="rtl" wit="#V #S">والسادك</rdg>
                    <rdg rend="rtl" wit="#T">والسادل</rdg>
                </app> بالله <app>
                    <rdg rend="rtl" wit="#V #S">روح واحد</rdg>
                    <rdg rend="rtl" wit="#T">روحًا واحدًا</rdg>
                </app> هو. قال ايوب. <app>
                    <rdg rend="rtl" wit="#V">إن</rdg>
                    <rdg rend="rtl" wit="#T #S">إنّ</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">قفا قلبي</rdg>
                    <rdg rend="rtl" wit="#T">تفاقبني</rdg>
                </app> امرأة رجل أخر <app>
                    <rdg rend="rtl" wit="#V">وواظبت</rdg>
                    <rdg rend="rtl" wit="#T #S">واطنبت</rdg>
                </app> الجلوس على بابها <app>
                    <rdg rend="rtl" wit="#V #S">فسيترضي</rdg>
                    <rdg rend="rtl" wit="#T">فسترخا</rdg>
                </app> امرأتي <app>
                    <rdg rend="rtl" wit="#V #S">رجلًا</rdg>
                    <rdg rend="rtl" wit="#T">رجل</rdg>
                </app> غيري. قال القديس باسيليوس العفّة في
                الهرم ليست عفة لكنّ ضعفًا عن الفجور. <app>
                    <rdg rend="rtl" wit="#V #S">قال الثاولوغس. انقياض الشيمة أفضل بانبساطها والأنا الداثر لا</rdg>
                    <rdg rend="rtl" wit="#T">من</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V">يوثق</rdg>
                    <rdg rend="rtl" wit="#S">يوتق</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">به على الطبيب. من</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app> كتاب <app>
                    <rdg rend="rtl" wit="#V #S">اقليمقس.</rdg>
                    <rdg rend="rtl" wit="#T">اقليمس</rdg>
                </app> الخادم <app>
                    <rdg rend="rtl" wit="#T #V">بطنه</rdg>
                    <rdg rend="rtl" wit="#S">بظنه</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">والموثران</rdg>
                    <rdg rend="rtl" wit="#T">والموثر أنّ</rdg>
                </app> يقهر <app>
                    <rdg rend="rtl" wit="#V #S">الروح</rdg>
                    <rdg rend="rtl" wit="#T">روح الر… يظاهي للمطفى</rdg>
                </app>  <app>
                    <rdg rend="rtl" wit="#V">الزنايضا</rdg>
                    <rdg rend="rtl" wit="#S">الرتايضا</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app>  <app>
                    <rdg rend="rtl" wit="#V #S">هي للمطفي</rdg>
                    <rdg rend="rtl" wit="#T"/>
                </app> النار <app>
                    <rdg rend="rtl" wit="#V #S">بالدهن. قال</rdg>
                    <rdg rend="rtl" wit="#T">بالرهن</rdg>
                </app>  <app>
